# ============================================================
# Health Dashboard — Environment Variables
# Copy this file to .env and fill in all required values.
# ============================================================

# --- Database (auth and preferences only — no health data) ---
DATABASE_URL=postgresql://health:health@localhost:5432/health
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=health

# --- Server ---
PORT=3001
HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Auth (Better Auth) ---
# Generate a strong random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
# Public-facing URL of the app (used to construct magic link URLs in emails).
# - Docker Compose: use the web service URL (http://localhost:5173) so links go through nginx
# - pnpm dev (no Docker): use the Fastify server URL (http://localhost:3001)
# - Production: use your public domain (https://app.example.com)
BETTER_AUTH_URL=http://localhost:5173

# --- Email (Resend) ---
# Used to send magic link sign-in emails.
# Sign up for a free API key at https://resend.com (3,000 emails/month free).
# Leave empty in local dev — magic links are printed to the server console instead.
RESEND_API_KEY=
# Sender address for magic link emails. Must use a domain verified in your Resend account.
# Falls back to noreply@resend.dev (only delivers to your own address — dev/testing only).
# Format: "Display Name <address@yourdomain.com>"
RESEND_FROM=Health Dashboard <noreply@yourdomain.com>

# --- Admin ---
# Email address that has access to the /admin page.
# The admin authenticates via magic link (same Resend flow as regular users).
# If unset, the /admin page returns 503 and is effectively disabled.
ADMIN_EMAIL=admin@example.com

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=your-api-key-here

# Model used for the health-insights chat. Optional — defaults to
# claude-sonnet-4-20250514 if unset. Use the exact API model ID, e.g.:
#   ANTHROPIC_MODEL=claude-opus-4-20250514       # most capable, higher cost
#   ANTHROPIC_MODEL=claude-sonnet-4-20250514     # balanced (default)
#   ANTHROPIC_MODEL=claude-3-5-haiku-20241022    # fastest, lowest cost
# Pinning a dated ID (…-20250514) keeps output stable; the undated alias
# (e.g. claude-sonnet-4-0) always tracks the latest snapshot of that model.
# Full list of current model IDs:
#   https://docs.anthropic.com/en/docs/about-claude/models/overview
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Whoop integration ---
# Whoop's API has no CORS, so the server proxies OAuth + data fetches. Each user
# brings their own Whoop developer app; their client secret is stored encrypted
# (AES-256-GCM) using this key. Required if any user connects Whoop.
# Generate a 32-byte key:  openssl rand -hex 32
WHOOP_ENCRYPTION_KEY=

# --- Cloudflare Turnstile (bot protection on login form) ---
# Sign up at https://www.cloudflare.com/products/turnstile/
# Leave both empty to disable Turnstile (magic link still works, no bot challenge).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- FHIR terminology (SNOMED CT lookups) ---
# The public SNOMED FHIR server has no CORS, so the browser cannot call it
# directly. The server relays /api/fhir/* to this upstream. Optional; defaults
# to the SNOMED International public Snowstorm server.
FHIR_TERMINOLOGY_URL=https://browser.ihtsdotools.org/fhir

# --- Web app (VITE_ prefix exposes to the browser) ---
# Client FHIR base. Leave empty/unset to use the same-origin /api/fhir proxy
# above (recommended). Only set this to a full URL if pointing the browser at a
# CORS-enabled terminology server directly.
VITE_FHIR_TERMINOLOGY_URL=
# API base URL (where the server is running, as seen from the browser)
VITE_API_URL=http://localhost:3001

# --- Production Docker Compose overrides ---
# Port mappings for production containers (docker-compose.prod.yml only)
WEB_PORT=80
SERVER_PORT=3001

# NPM compose only: name of the external Docker network that nginx-proxy-manager is on.
# Create it once with: docker network create proxy
# Default: proxy
PROXY_NETWORK_NAME=proxy
